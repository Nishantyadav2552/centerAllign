# ==============================================================================
# CentrAlign Operator Configuration
# ==============================================================================

# LLM Configuration
# Options: 'demo' (deterministic autonomous agent mode), 'openai', 'anthropic', 'gemini'
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4o

# Execution & Autonomy Controls
# Set DEMO_MODE to true to run deterministic execution with real tools, recovery, and verification
DEMO_MODE=true
MAX_TOOL_CALLS_PER_TASK=15
MAX_RETRIES_PER_ACTION=2
TOOL_TIMEOUT_SECONDS=30

# Policy & Safety Gates
# If false, financial creations require human supervisor authorization
AUTO_APPROVE_FINANCIAL_RECORDS=false

# Database
DATABASE_URL=sqlite:///data/centralign.db

# Demo Portal Origins
PORTAL_BASE_URL=http://127.0.0.1:8000/portal
